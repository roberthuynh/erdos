    RectangleCovered S m := by
  rcases le_total m (37/80) with hcut0 | hcut0
  · rcases le_total S (2209/1024) with hcut1 | hcut1
    · rcases le_total m (73/160) with hcut2 | hcut2
      · rcases le_total S (4407/2048) with hcut3 | hcut3
        · exact ⟨(1099/512), (4407/2048), (9/20), (73/160), rectangle_valid_390, hSl, hcut3, hmL, hcut2⟩
