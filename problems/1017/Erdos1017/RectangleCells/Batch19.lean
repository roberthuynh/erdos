          · exact ⟨(283/128), (1143/512), (1/2), (41/80), rectangle_valid_090, hSl, hcut3, hmL, hcut4⟩
          · exact ⟨(283/128), (1143/512), (41/80), (21/40), rectangle_valid_089, hSl, hcut3, hcut4, hcut2⟩
        · rcases le_total m (41/80) with hcut5 | hcut5
          · exact ⟨(1143/512), (577/256), (1/2), (41/80), rectangle_valid_088, hcut3, hcut1, hmL, hcut5⟩
          · exact ⟨(1143/512), (577/256), (41/80), (21/40), rectangle_valid_087, hcut3, hcut1, hcut5, hcut2⟩
      · rcases le_total S (1143/512) with hcut6 | hcut6
