    RectangleCovered S m := by
  rcases le_total m (11/20) with hcut0 | hcut0
  · rcases le_total S (577/256) with hcut1 | hcut1
    · rcases le_total m (21/40) with hcut2 | hcut2
      · rcases le_total S (1143/512) with hcut3 | hcut3
