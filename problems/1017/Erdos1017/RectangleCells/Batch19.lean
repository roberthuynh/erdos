          · exact ⟨(283/128), (1143/512), (21/40), (43/80), rectangle_valid_086, hSl, hcut6, hcut2, hcut7⟩
          · exact ⟨(283/128), (1143/512), (43/80), (11/20), rectangle_valid_085, hSl, hcut6, hcut7, hcut0⟩
        · rcases le_total m (43/80) with hcut8 | hcut8
          · exact ⟨(1143/512), (577/256), (21/40), (43/80), rectangle_valid_084, hcut6, hcut1, hcut2, hcut8⟩
          · exact ⟨(1143/512), (577/256), (43/80), (11/20), rectangle_valid_083, hcut6, hcut1, hcut8, hcut0⟩
    · rcases le_total m (21/40) with hcut9 | hcut9
      · rcases le_total S (1165/512) with hcut10 | hcut10
        · rcases le_total m (41/80) with hcut11 | hcut11
          · exact ⟨(577/256), (1165/512), (1/2), (41/80), rectangle_valid_082, hcut1, hcut10, hmL, hcut11⟩
          · exact ⟨(577/256), (1165/512), (41/80), (21/40), rectangle_valid_081, hcut1, hcut10, hcut11, hcut9⟩
        · exact ⟨(1165/512), (147/64), (1/2), (21/40), rectangle_valid_080, hcut10, hSh, hmL, hcut9⟩
