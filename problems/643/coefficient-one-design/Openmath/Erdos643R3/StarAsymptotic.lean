import Mathlib
import FormalConjecturesForMathlib.Combinatorics.Hypergraph.Finite

/-!
# The star lower bound and coefficient-one asymptotics in actual upstream vocabulary

The star through a fixed vertex has C(n-1,2) triples and no disjoint pair of triples.
This proves the lower bound for the genuine imported `Hypergraph.extremalNumber`.
The limiting statements take the coefficient-one upper bound as an explicit hypothesis;
that hypothesis is to be supplied by the separately formalized finite upper theorem.
The forcing function is exactly `extremalNumber + 1`, as in upstream Erdős 643 at t=3.
-/

set_option autoImplicit false
namespace Erdos643R3.StarAsymptotic
open Finset Filter
open scoped Topology Asymptotics

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- The 3-uniform star through a fixed vertex, generated by its other two vertices. -/
def star (x : V) : Finset (Finset V) :=
  ((univ.erase x).powersetCard 2).image (insert x)

theorem apex_mem {x : V} {e : Finset V} (he : e ∈ star x) : x ∈ e := by
  obtain ⟨p, -, rfl⟩ := mem_image.mp he
  simp

theorem star_uniform (x : V) : (star x).IsUniform 3 := by
  intro e he
  obtain ⟨p, hp, rfl⟩ := mem_image.mp he
  obtain ⟨hsub, hcard⟩ := mem_powersetCard.mp hp
  have hx : x ∉ p := fun h => notMem_erase x univ (hsub h)
  rw [card_insert_of_notMem hx, hcard]

theorem star_avoids (x : V) : ¬ (star x).HasRepeatedDisjointUnion := by
  rintro ⟨A,hA,B,hB,C,hC,D,hD,hAB,_⟩
  exact disjoint_left.mp hAB (apex_mem hA) (apex_mem hB)

theorem star_card (x : V) : (star x).card = (Fintype.card V - 1).choose 2 := by
  unfold star
  rw [card_image_of_injOn]
  · rw [card_powersetCard,card_erase_of_mem (mem_univ x),card_univ]
  · intro p hp q hq he
    have hpx : x ∉ p := fun h => notMem_erase x univ ((mem_powersetCard.mp hp).1 h)
    have hqx : x ∉ q := fun h => notMem_erase x univ ((mem_powersetCard.mp hq).1 h)
    have h := congrArg (fun s : Finset V => s.erase x) he
    simpa [hpx,hqx] using h

/-- The generated star is exactly the set of all triples containing x. -/
theorem mem_star_iff {x : V} {e : Finset V} : e ∈ star x ↔ e.card = 3 ∧ x ∈ e := by
  constructor
  · intro h
    exact ⟨star_uniform x e h,apex_mem h⟩
  · rintro ⟨hc,hx⟩
    apply mem_image.mpr
    refine ⟨e.erase x,mem_powersetCard.mpr ⟨?_,?_⟩,insert_erase hx⟩
    · intro y hy
      exact mem_erase.mpr ⟨(mem_erase.mp hy).1,mem_univ y⟩
    · rw [card_erase_of_mem hx,hc]

/-- Actual upstream ex_3(n), with all quantifiers and the forbidden predicate unchanged. -/
noncomputable def ex3 (n : ℕ) : ℕ :=
  Hypergraph.extremalNumber n 3 (fun H => ¬ H.HasRepeatedDisjointUnion)

/-- Actual upstream forcing threshold f(n;3), which is ex_3(n)+1. -/
noncomputable def forcing (n : ℕ) : ℕ := ex3 n + 1

/-- Unconditional star lower bound, including n=0. -/
theorem star_lower_bound (n : ℕ) : (n-1).choose 2 ≤ ex3 n := by
  classical
  cases n with
  | zero => simp
  | succ n =>
    let x : Fin (n+1) := ⟨0,by omega⟩
    have hc : (star x).card = (n+1-1).choose 2 := by
      rw [star_card,Fintype.card_fin]
    unfold ex3 Hypergraph.extremalNumber
    rw [← hc]
    apply Finset.le_sup (f := Finset.card)
    simp only [Finset.mem_filter, Finset.mem_powerset]
    refine ⟨?_,star_avoids x⟩
    intro e he
    exact mem_powersetCard.mpr ⟨subset_univ e,star_uniform x e he⟩

/-- Real-valued binomial formula used for both limits. -/
theorem choose_two_real (n : ℕ) : (n.choose 2 : ℝ) = (n : ℝ) * ((n : ℝ)-1) / 2 :=
  Nat.cast_choose_two ℝ n

/-- The star's normalized cardinality is exactly 1-2/n when n≥2. -/
theorem star_ratio {n : ℕ} (hn : 2 ≤ n) :
    ((n-1).choose 2 : ℝ) / (n.choose 2 : ℝ) = 1 - 2 / (n : ℝ) := by
  have h1 : 1 ≤ n := by omega
  have hr : (2 : ℝ) ≤ n := by exact_mod_cast hn
  rw [choose_two_real,choose_two_real,Nat.cast_sub h1]
  push_cast
  have hn0 : (n : ℝ) ≠ 0 := by linarith
  have hn1 : (n : ℝ)-1 ≠ 0 := by linarith
  field_simp
  ring

/-- For n≥3 the number of pairs is at least n. -/
theorem le_choose_two_real {n : ℕ} (hn : 3 ≤ n) : (n : ℝ) ≤ (n.choose 2 : ℝ) := by
  have hr : (3 : ℝ) ≤ n := by exact_mod_cast hn
  rw [choose_two_real]
  nlinarith

/-- Both the extremal and forcing ratios are squeezed by bounds tending to one. -/
theorem ratio_bounds {n : ℕ} (hn : 3 ≤ n) (hu : ex3 n ≤ n.choose 2) :
    1 - 2 / (n : ℝ) ≤ (ex3 n : ℝ) / (n.choose 2 : ℝ) ∧
    (ex3 n : ℝ) / (n.choose 2 : ℝ) ≤ (forcing n : ℝ) / (n.choose 2 : ℝ) ∧
    (forcing n : ℝ) / (n.choose 2 : ℝ) ≤ 1 + 1 / (n : ℝ) := by
  have hnpos : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
  have hc := le_choose_two_real hn
  have hcp : (0 : ℝ) < (n.choose 2 : ℝ) := lt_of_lt_of_le hnpos hc
  have hl : ((n-1).choose 2 : ℝ) ≤ (ex3 n : ℝ) := by exact_mod_cast star_lower_bound n
  have hu' : (ex3 n : ℝ) ≤ (n.choose 2 : ℝ) := by exact_mod_cast hu
  have hf : (forcing n : ℝ) = (ex3 n : ℝ)+1 := by simp [forcing]
  refine ⟨?_,?_,?_⟩
  · rw [← star_ratio (by omega : 2 ≤ n)]
    exact div_le_div_of_nonneg_right hl hcp.le
  · rw [hf]
    exact div_le_div_of_nonneg_right (by linarith) hcp.le
  · rw [hf]
    have hinv : 1 / (n.choose 2 : ℝ) ≤ 1 / (n : ℝ) := one_div_le_one_div_of_le hnpos hc
    have hx : (ex3 n : ℝ) / (n.choose 2 : ℝ) ≤ 1 := (div_le_one hcp).mpr hu'
    rw [add_div]
    linarith

/-- Conditional solely on the coefficient-one finite upper bound: ex_3(n)/C(n,2)→1. -/
theorem ex3_ratio_tendsto_one (hu : ∀ n : ℕ, ex3 n ≤ n.choose 2) :
    Tendsto (fun n : ℕ => (ex3 n : ℝ)/(n.choose 2 : ℝ)) atTop (𝓝 1) := by
  have hl : Tendsto (fun n : ℕ => 1-2/(n : ℝ)) atTop (𝓝 1) := by
    convert tendsto_const_nhds.sub (tendsto_const_div_atTop_nhds_zero_nat (2 : ℝ)) using 1
    norm_num
  have hh : Tendsto (fun n : ℕ => 1+1/(n : ℝ)) atTop (𝓝 1) := by
    convert tendsto_const_nhds.add (tendsto_one_div_atTop_nhds_zero_nat (𝕜 := ℝ)) using 1
    norm_num
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le' hl hh
  · filter_upwards [eventually_ge_atTop 3] with n hn
    exact (ratio_bounds hn (hu n)).1
  · filter_upwards [eventually_ge_atTop 3] with n hn
    exact (ratio_bounds hn (hu n)).2.1.trans (ratio_bounds hn (hu n)).2.2

/-- The actual forcing function also has limiting ratio one, including its +1. -/
theorem forcing_ratio_tendsto_one (hu : ∀ n : ℕ, ex3 n ≤ n.choose 2) :
    Tendsto (fun n : ℕ => (forcing n : ℝ)/(n.choose 2 : ℝ)) atTop (𝓝 1) := by
  have hl : Tendsto (fun n : ℕ => 1-2/(n : ℝ)) atTop (𝓝 1) := by
    convert tendsto_const_nhds.sub (tendsto_const_div_atTop_nhds_zero_nat (2 : ℝ)) using 1
    norm_num
  have hh : Tendsto (fun n : ℕ => 1+1/(n : ℝ)) atTop (𝓝 1) := by
    convert tendsto_const_nhds.add (tendsto_one_div_atTop_nhds_zero_nat (𝕜 := ℝ)) using 1
    norm_num
  apply tendsto_of_tendsto_of_tendsto_of_le_of_le' hl hh
  · filter_upwards [eventually_ge_atTop 3] with n hn
    exact (ratio_bounds hn (hu n)).1.trans (ratio_bounds hn (hu n)).2.1
  · filter_upwards [eventually_ge_atTop 3] with n hn
    exact (ratio_bounds hn (hu n)).2.2

/-- Exact upstream asymptotic statement at t=3, conditional solely on its finite upper bound. -/
theorem forcing_isEquivalent (hu : ∀ n : ℕ, ex3 n ≤ n.choose 2) :
    (fun n : ℕ => ((Hypergraph.extremalNumber n 3 (fun H => ¬ H.HasRepeatedDisjointUnion)+1 : ℕ) : ℝ))
      ~[atTop] (fun n : ℕ => (n.choose (3-1) : ℝ)) :=
  Asymptotics.isEquivalent_of_tendsto_one (forcing_ratio_tendsto_one hu)

theorem ex3_isEquivalent (hu : ∀ n : ℕ, ex3 n ≤ n.choose 2) :
    (fun n : ℕ => (Hypergraph.extremalNumber n 3 (fun H => ¬ H.HasRepeatedDisjointUnion) : ℝ))
      ~[atTop] (fun n : ℕ => (n.choose 2 : ℝ)) :=
  Asymptotics.isEquivalent_of_tendsto_one (ex3_ratio_tendsto_one hu)

end Erdos643R3.StarAsymptotic
